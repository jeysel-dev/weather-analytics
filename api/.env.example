# API (FastAPI) — variáveis de ambiente. Copie para api/.env (gitignored)
# para rodar localmente. Em produção vêm do container / secret do infra.

# Projeto GCP dono dos datasets BigQuery
GCP_PROJECT_ID=seu-projeto-gcp

# Dataset onde as marts do dbt aterrissaram
BIGQUERY_DATASET=marts

# Dataset dos seeds do dbt (tabela locations); default = BIGQUERY_DATASET
BIGQUERY_SEEDS_DATASET=seeds

# Região do BigQuery — mesma do pipeline/dbt
BIGQUERY_LOCATION=southamerica-east1

# Caminho absoluto para a chave JSON da service account dedicada da API
# (weather-analytics-api-sa, read-only: bigquery.jobUser no projeto +
# bigquery.dataViewer nos datasets marts/seeds).
GOOGLE_APPLICATION_CREDENTIALS_API=/path/to/service-account-key.json
